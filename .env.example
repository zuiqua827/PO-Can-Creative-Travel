# ==============================================================================
# CAN Travel — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Do NOT commit actual secrets (API keys, passwords, private tokens) to Git.
# - Duplicate this file to .env and configure values according to your environment.
# ==============================================================================

# Application Identity & Lifecycle
APP_NAME="CAN Travel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cantravel.co.id

# Logging Configuration
# Structured log channels: payments, security, booking, stack
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Connection (MySQL 8.0+ / MariaDB 10.4+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=can_travel_prod
DB_USERNAME=can_travel_user
DB_PASSWORD=

# Session, Cache & Storage Drivers
# For single-server deployments: file/database. For multi-node: redis.
BROADCAST_DRIVER=log
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=public

# Optional Redis Configuration (if REDIS is used for cache/queue)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing Mail Configuration (Transactional Notifications)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@cantravel.co.id"
MAIL_FROM_NAME="CAN Travel"

# ==============================================================================
# CAN Travel Payment Architecture
# ==============================================================================
# Supported drivers:
# - fake     : Local offline simulation mode (auto or manual confirmation)
# - midtrans : Official Midtrans Snap & Core API integration
PAYMENT_DRIVER=midtrans
PAYMENT_CURRENCY=IDR
PAYMENT_EXPIRY_MINUTES=120
PAYMENT_WEBHOOK_SECRET=

# Midtrans Production Gateway Credentials
# Retrieve from: https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SNAP_URL="https://app.midtrans.com/snap/v1/transactions"
MIDTRANS_API_BASE_URL="https://api.midtrans.com"

# Simulation / Sandbox Helper (Used only when PAYMENT_DRIVER=fake)
PAYMENT_SIMULATION_AUTO_CONFIRM=false
